#!/usr/bin/env bash
# worker-cli: worker lifecycle operations via iterative-dev plugin
# Source: Meta/blank/bin/worker-cli — symlinked to ~/.local/bin/worker-cli

set -e

PLUGIN="${CLAUDE_PLUGIN_ROOT:-$HOME/.claude/plugins/cache/brunowinter-plugins/iterative-dev/1.0.0}"
SPAWN="$PLUGIN/src/spawn/tmux_spawn.sh"
REGISTRY_DIR="${WORKER_REGISTRY_DIR:-$HOME/.claude/.worker-registry}"

usage() {
    cat <<'EOF'
usage: worker-cli <cmd> [args]

  list [project_path]                                        — list active workers (all if no path)
  status <name>                                              — idle / working / limit reached / unknown
  status --all [project_path]                                — snapshot all workers in one call
  capture <name> [--raw]                                     — clean output since last prompt (--raw: raw pane to file)
  response <name> [N]                                        — clean last N assistant turns from session JSONL (default 1)
  merge <name>                                               — log + merge branch into current
  kill <name>                                                — tmux + worktree + branch cleanup (spawn + all registered cross-project)
  send <name> <message>                                      — send message to running worker
  wait [project_path] [--timeout N]                          — block until all workers of the project go stably idle (default timeout 3300s)
  spawn <name> <prompt_file> <project_path> [model] [--no-worktree]
                                                             — spawn worker in git worktree
  revive <name>                                              — re-launch dead worker with --resume (full prior context)
  worktree <name> <target-repo> [branch]                    — create + register cross-project worktree (default branch=<name>)
  worktree-rm <target-repo> <name> [branch]                 — remove cross-project worktree+branch (orphan cleanup, no registry needed)

model: claude-sonnet-5 (default) | opus
Worker names are globally unique (registry-tracked). Project path is required only for spawn;
other commands auto-resolve via the registry.
Project path: absolute, ~/, or 'c' (resolves to current git project root, worktree-aware).
  'c' works from any directory: project root, subdirectory, or inside a worktree.
Cross-project flow: spawn (creates spawn-side worktree) → worktree <name> <target> (creates + registers
  target-side worktree) → worker works there → kill <name> (cleans both sides).
EOF
}

# Resolve project path — accepts absolute path, relative path, or 'c' / '.' / empty.
# Strips /.claude/worktrees/<name> suffix if present, then walks up to nearest .git root.
# NOTE: stops at first .git found — does not traverse into submodules.
resolve_project_path() {
    local dir="${1:-$(pwd)}"
    case "$dir" in c|.|'') dir="$(pwd)" ;; esac
    # Relative path → make absolute
    [[ "$dir" != /* ]] && dir="$(pwd)/$dir"
    # Strip worktree suffix to land at project root directly
    if [[ "$dir" == */.claude/worktrees/* ]]; then
        dir="${dir%%/.claude/worktrees/*}"
    fi
    # Walk up to nearest .git (covers both git dirs and worktree .git files)
    local d="$dir"
    while [[ "$d" != "/" && -n "$d" ]]; do
        [[ -e "$d/.git" ]] && { echo "$d"; return 0; }
        d="$(dirname "$d")"
    done
    echo "$dir"
}

# --- Registry helpers ---

registry_write() {
    local name="$1" project="$2"
    mkdir -p "$REGISTRY_DIR"
    echo "$project" > "$REGISTRY_DIR/$name"
}

registry_read() {
    local name="$1"
    local f="$REGISTRY_DIR/$name"
    [ -f "$f" ] && cat "$f" || echo ""
}

registry_delete() {
    local name="$1"
    rm -f "$REGISTRY_DIR/$name"
}

# --- Sidecar helpers (cross-project worktrees) ---
# File: $REGISTRY_DIR/<name>.worktrees — one "<target-repo>\t<branch>" per line

sidecar_append() {
    local name="$1" target="$2" branch="$3"
    mkdir -p "$REGISTRY_DIR"
    printf '%s\t%s\n' "$target" "$branch" >> "$REGISTRY_DIR/$name.worktrees"
}

sidecar_delete() {
    local name="$1"
    rm -f "$REGISTRY_DIR/$name.worktrees"
}

# Tmux scan fallback: derive project_path from session name pattern worker-<basename>-<name>.
# Searches ~/Documents/ai/ (3 levels deep) for dir named <basename> containing .git.
# Writes result to registry and returns it. Returns 1 if not found.
tmux_scan_project() {
    local name="$1"
    local count
    count=$(tmux ls 2>/dev/null | grep -cE "^worker-[^:]+-${name}:" || echo 0)
    if [ "$count" -eq 0 ]; then
        return 1
    fi
    if [ "$count" -gt 1 ]; then
        echo "worker-cli: multiple tmux sessions match worker name '$name':" >&2
        tmux ls 2>/dev/null | grep -oE "^worker-[^:]*-${name}[^:]*" >&2
        return 1
    fi
    local session
    session=$(tmux ls 2>/dev/null | grep -oE "^worker-[^:]*-${name}:" | head -1)
    session="${session%:}"
    # Extract basename: strip "worker-" prefix and "-<name>" suffix
    local middle="${session#worker-}"
    local proj_basename="${middle%-${name}}"
    # Scan ~/Documents/ai/ up to 6 levels for dir named proj_basename containing .git
    local found=""
    while IFS= read -r d; do
        if [ -e "$d/.git" ]; then
            found="$d"
            break
        fi
    done < <(find ~/Documents/ai -maxdepth 6 -type d -name "$proj_basename" 2>/dev/null)
    if [ -n "$found" ]; then
        registry_write "$name" "$found"
        echo "$found"
        return 0
    fi
    return 1
}

# Resolve project path for a named worker.
# Resolution order: explicit override → registry → tmux scan fallback → error.
# If override is non-empty, treat it as the project_path (backwards compat).
resolve_worker_project() {
    local name="$1"
    local override="${2:-}"
    if [ -n "$override" ]; then
        resolve_project_path "$override"
        return 0
    fi
    local from_registry
    from_registry=$(registry_read "$name")
    if [ -n "$from_registry" ]; then
        echo "$from_registry"
        return 0
    fi
    local from_tmux
    from_tmux=$(tmux_scan_project "$name" 2>&1) || true
    if [ -n "$from_tmux" ] && [[ "$from_tmux" != *"worker-cli:"* ]]; then
        echo "$from_tmux"
        return 0
    fi
    echo "worker-cli: worker '$name' not found in registry or tmux" >&2
    exit 1
}

# Encode an absolute path to the ~/.claude/projects/ dir name: replace /, ., _ with -.
encode_worktree_path() {
    local p="$1"
    p="${p//\//-}"; p="${p//\./-}"; p="${p//_/-}"
    echo "$p"
}

# --- wait helpers ---
# Poll cadence + stability window for `wait`. Two consecutive idle samples aren't enough to
# rule out a sampling race at the exact hook-transition instant; three samples 5s apart give
# a 10s span between the first and last confirmation — reuses the same 10s figure
# _worker_detect_status already relies on for its window_activity stale-check (worker_status_hooks_source.md),
# an already-vetted "long enough to not be noise" constant in this codebase.
_WAIT_POLL_INTERVAL=5
_WAIT_STABLE_SAMPLES=3

# _wait_has_live_bg_task NAME PROJECT_PATH
#   Handle-based background-task check (2026-08, replaces a process-tree walk that produced a
#   live false-positive incident: a persistent tooling child under the worker's claude pid —
#   observed live, pyright-langserver running 36+ minutes — made every grandchild-count check
#   read "busy" forever, so `wait` degraded to the timeout ceiling on any worker that ever spawned
#   tooling). Mirrors monitor-cc's src/menubar/proc_cache.py (`_has_active_bg` /
#   `_refresh_bg_task_cache`), NOT reimported: a session's backgrounded Bash task is in-progress
#   iff some process holds an open WRITE handle on a *.output file under
#   /tmp/claude-<uid>/<encoded-session-cwd>/<session-id>/tasks/ — the exact directory Claude Code
#   itself writes background-task output into. LSP/MCP/tooling child processes never hold such a
#   handle, so they never register here, unlike the old grandchild-count check.
#   encoded/session_id derived exactly like _worker_detect_status (pane_current_path -> tr
#   '/_.' '-' -> newest ~/.claude/projects/<encoded>/*.jsonl basename) — always the SAME session
#   tmux_spawn.sh's own status check just resolved.
#   /tmp -> /private/tmp (macOS symlink) resolved once via `cd /tmp && pwd -P` before building the
#   tasks-dir path — mirrors _TASKS_BASE_REAL in the reference module (lsof reports the resolved
#   form; live-confirmed real occupied task dirs on this machine report as /private/tmp/...).
#   Scoped per-worker (`lsof +D <this session's tasks dir>` only) rather than the reference's one
#   global scan per tick — deliberate simplification: that batching amortizes lsof across MANY
#   sessions polled every tick in the menubar; here each call checks exactly one worker, so a
#   directly-scoped call is simpler AND strictly narrower/faster (no manual prefix-filter needed,
#   lsof's own +D traversal already guarantees scope). ~120ms per call, measured — cheap for the
#   5s poll cadence.
#   lsof's own exit code is NOT used as a signal: verified live that `lsof +D <dir> -Fn` can exit
#   1 even when it DOES find open files (an observed lsof quirk on this system) — matches the
#   reference module's own approach of parsing stdout unconditionally rather than gating on the
#   subprocess return code. CRITICAL: `out=$(lsof ...)` MUST carry `|| true` — `source "$1"`
#   (tmux_spawn.sh) re-applies ITS OWN `set -euo pipefail` to this same shell for everything after
#   the source line; a bare assignment whose command substitution exits non-zero aborts the whole
#   subshell immediately under inherited set -e (same failure class documented in
#   worker_status_hooks_source.md) — without the guard, lsof's exit-1-on-success quirk above
#   turned "tasks dir exists" into an unconditional "error" on every single call, live-caught via
#   a `set -x` trace mid-debug (the assignment line printed, then the subshell silently died with
#   no further trace and no output, which the outer `2>/dev/null || echo error` then reported).
#   Echoes "yes" (open .output handle found), "no" (none found), or "error" (probe failed —
#   caller must treat as "yes", per the fail-toward-waiting contract) — never raises.
_wait_has_live_bg_task() {
    local name="$1" project="$2"
    bash -c '
        source "$1"
        session=$(_worker_session_name "$2" "$3")
        worktree=$(tmux display-message -t "${session}:^" -p "#{pane_current_path}" 2>/dev/null) || { echo error; exit 0; }
        [ -z "$worktree" ] && { echo error; exit 0; }
        encoded=$(echo "$worktree" | tr "/_." "-")
        jsonl=$(ls -t "$HOME/.claude/projects/${encoded}"/*.jsonl 2>/dev/null | head -1)
        [ -z "$jsonl" ] && { echo error; exit 0; }
        session_id=$(basename "$jsonl" .jsonl)
        command -v lsof >/dev/null 2>&1 || { echo error; exit 0; }
        real_tmp=$(cd /tmp 2>/dev/null && pwd -P) || real_tmp="/tmp"
        tasks_dir="${real_tmp}/claude-$(id -u)/${encoded}/${session_id}/tasks"
        [ -d "$tasks_dir" ] || { echo no; exit 0; }
        out=$(lsof +D "$tasks_dir" -Fn 2>/dev/null) || true
        found=no
        while IFS= read -r line; do
            case "$line" in
                n*.output) found=yes; break ;;
            esac
        done <<< "$out"
        echo "$found"
    ' _ "$SPAWN" "$project" "$name" 2>/dev/null || echo error
}


if [ $# -eq 0 ]; then
    usage
    exit 2
fi

CMD="$1"
shift

case "$CMD" in
    list)
        if [ $# -eq 0 ]; then
            # No project_path — list all known workers from registry
            if [ ! -d "$REGISTRY_DIR" ] || [ -z "$(ls -A "$REGISTRY_DIR" 2>/dev/null)" ]; then
                echo "(no known workers in registry)"
            else
                for _f in "$REGISTRY_DIR"/*; do
                    [ -f "$_f" ] || continue
                    [[ "$_f" == *.worktrees ]] && continue
                    _wname=$(basename "$_f")
                    _proj=$(cat "$_f")
                    _status=$(bash -c "source \"$SPAWN\" && worker_status \"\$1\" \"\$2\"" \
                        _ "$_wname" "$_proj" 2>/dev/null || echo "unknown")
                    echo "${_wname}: ${_status}  (${_proj})"
                done
            fi
        else
            PROJECT=$(resolve_project_path "$1")
            bash -c "source \"$SPAWN\" && worker_list \"\$1\"" _ "$PROJECT"
        fi
        ;;
    status)
        if [ "${1:-}" = "--all" ]; then
            shift
            if [ $# -ge 1 ]; then
                # Project-scoped
                PROJECT=$(resolve_project_path "$1")
                NAMES=$(bash -c "source \"$SPAWN\" && worker_list \"\$1\"" _ "$PROJECT" 2>/dev/null \
                    | awk '{print $1}')
                if [ -z "$NAMES" ]; then
                    echo "(no active workers)"
                else
                    while IFS= read -r wname; do
                        STATUS=$(bash -c "source \"$SPAWN\" && worker_status \"\$1\" \"\$2\"" \
                            _ "$wname" "$PROJECT" 2>/dev/null || echo "unknown")
                        echo "${wname}: ${STATUS}"
                    done <<< "$NAMES"
                fi
            else
                # All from registry
                if [ ! -d "$REGISTRY_DIR" ] || [ -z "$(ls -A "$REGISTRY_DIR" 2>/dev/null)" ]; then
                    echo "(no active workers)"
                else
                    for _f in "$REGISTRY_DIR"/*; do
                        [ -f "$_f" ] || continue
                        [[ "$_f" == *.worktrees ]] && continue
                        _wname=$(basename "$_f")
                        _proj=$(cat "$_f")
                        _status=$(bash -c "source \"$SPAWN\" && worker_status \"\$1\" \"\$2\"" \
                            _ "$_wname" "$_proj" 2>/dev/null || echo "unknown")
                        echo "${_wname}: ${_status}"
                    done
                fi
            fi
        else
            [ $# -lt 1 ] && { echo "worker-cli status: need <name> [project_path]" >&2; exit 2; }
            NAME="$1"
            OVERRIDE="${2:-}"
            PROJECT=$(resolve_worker_project "$NAME" "$OVERRIDE")
            STATUS=$(bash -c "source \"$SPAWN\" && worker_status \"\$1\" \"\$2\"" \
                _ "$NAME" "$PROJECT" 2>/dev/null || echo "unknown")
            echo "${STATUS}"
        fi
        ;;
    capture)
        [ $# -lt 1 ] && { echo "worker-cli capture: need <name> [--raw] [project_path]" >&2; exit 2; }
        NAME="$1"; shift
        RAW=0; OVERRIDE=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --raw) RAW=1 ;;
                *)     OVERRIDE="$1" ;;
            esac
            shift
        done
        PROJECT=$(resolve_worker_project "$NAME" "$OVERRIDE")
        if [ "$RAW" = "1" ]; then
            bash -c "source \"$SPAWN\" && worker_capture \"\$1\" \"\" \"\$2\"" \
                _ "$NAME" "$PROJECT"
        else
            bash -c "source \"$SPAWN\" && worker_capture_clean \"\$1\" \"\$2\"" \
                _ "$NAME" "$PROJECT"
        fi
        ;;
    response)
        [ $# -lt 1 ] && { echo "worker-cli response: need <name> [count] [project_path]" >&2; exit 2; }
        NAME="$1"
        # Position 2: integer => count of last N assistant turns; else => project_path override
        COUNT=1
        OVERRIDE=""
        if [ -n "${2:-}" ]; then
            if [[ "$2" =~ ^[0-9]+$ ]]; then
                COUNT="$2"
                OVERRIDE="${3:-}"
            else
                OVERRIDE="$2"
            fi
        fi
        PROJECT=$(resolve_worker_project "$NAME" "$OVERRIDE")
        WORKTREE="$PROJECT/.claude/worktrees/$NAME"
        if [ ! -d "$WORKTREE" ]; then
            echo "worker-cli response: no worktree for $NAME at $WORKTREE" >&2
            exit 2
        fi
        PROJECTS_DIR="$HOME/.claude/projects"
        if [ ! -d "$PROJECTS_DIR" ]; then
            echo "worker-cli response: ~/.claude/projects not found" >&2
            exit 3
        fi
        ENCODED_DIR="$PROJECTS_DIR/$(encode_worktree_path "$WORKTREE")"
        JSONL=$(ls -t "$ENCODED_DIR"/*.jsonl 2>/dev/null | head -1)
        if [ -z "$JSONL" ]; then
            echo "worker-cli response: no session JSONL found for $NAME at $ENCODED_DIR" >&2
            exit 4
        fi
        TEXT=$(jq -rs --argjson n "$COUNT" '[.[] | select(.type == "assistant" and (.message.content // [] | map(select(.type == "text")) | length > 0))] | if length == 0 then "" else (.[-($n):] | length as $L | to_entries | map("=== msg \(.key + 1)/\($L) ===\n" + (.value.message.content | map(select(.type == "text")) | map(.text) | join("\n\n"))) | join("\n\n")) end' "$JSONL" 2>/dev/null || true)
        if [ -z "$TEXT" ]; then
            echo "worker-cli response: no assistant text message found in $JSONL" >&2
            exit 5
        fi
        CHARS=${#TEXT}
        echo "=== response from $NAME (last $COUNT, $CHARS chars) ==="
        echo "$TEXT"
        ;;
    merge)
        [ $# -lt 1 ] && { echo "worker-cli merge: need <name> [project_path]" >&2; exit 2; }
        NAME="$1"
        OVERRIDE="${2:-}"
        PROJECT=$(resolve_worker_project "$NAME" "$OVERRIDE")
        CURRENT=$(git -C "$PROJECT" branch --show-current)
        echo "=== Commits on branch $NAME not in $CURRENT ==="
        git -C "$PROJECT" log "$CURRENT".."$NAME" --oneline -- || true
        echo
        echo "=== Merging $NAME into $CURRENT ==="
        git -C "$PROJECT" merge "$NAME" --no-ff -m "merge: worker $NAME"
        ;;
    kill)
        [ $# -lt 1 ] && { echo "worker-cli kill: need <name> [project_path]" >&2; exit 2; }
        NAME="$1"
        OVERRIDE="${2:-}"
        PROJECT=$(resolve_worker_project "$NAME" "$OVERRIDE")
        SESSION="worker-$(basename "$PROJECT")-$NAME"
        echo "Killing worker: $SESSION"
        # Stop diagnostic logger sidecar first (so it doesn't write a spurious death snapshot)
        bash -c "source \"$SPAWN\" && _stop_worker_logger \"\$1\"" _ "$NAME" 2>/dev/null || true
        tmux kill-session -t "$SESSION" 2>/dev/null && echo "  tmux session: killed" || echo "  tmux session: not found"
        git -C "$PROJECT" worktree remove --force ".claude/worktrees/$NAME" 2>/dev/null && echo "  worktree: removed" || echo "  worktree: not found"
        git -C "$PROJECT" branch -D "$NAME" 2>/dev/null && echo "  branch: deleted" || echo "  branch: not found"
        # Best-effort signal cleanup so the menubar doesn't keep a stale grace entry around
        bash -c "source \"$SPAWN\" && _orchestrator_signal_delete \"$SESSION\"" 2>/dev/null || true
        # Clean cross-project worktrees registered in sidecar (best-effort — never blocks registry_delete)
        _SIDECAR="$REGISTRY_DIR/$NAME.worktrees"
        if [ -f "$_SIDECAR" ]; then
            while IFS=$'\t' read -r _xrepo _xbranch; do
                [ -z "$_xrepo" ] && continue
                [ -z "$_xbranch" ] && _xbranch="$NAME"
                git -C "$_xrepo" worktree remove --force ".claude/worktrees/$NAME" 2>/dev/null \
                    && echo "  cross-project worktree ($_xrepo): removed" \
                    || echo "  cross-project worktree ($_xrepo): not found"
                git -C "$_xrepo" branch -D "$_xbranch" 2>/dev/null \
                    && echo "  cross-project branch $_xbranch ($_xrepo): deleted" \
                    || echo "  cross-project branch $_xbranch ($_xrepo): not found"
            done < "$_SIDECAR"
            rm -f "$_SIDECAR"
            echo "  cross-project sidecar: removed"
        fi
        registry_delete "$NAME"
        echo "  registry: removed"
        ;;
    send)
        [ $# -lt 2 ] && { echo "worker-cli send: need <name> <message> [project_path]" >&2; exit 2; }
        NAME="$1"
        MESSAGE="$2"
        OVERRIDE="${3:-}"
        PROJECT=$(resolve_worker_project "$NAME" "$OVERRIDE")
        _WORKER_MSG="$MESSAGE" bash -c 'source "$1" && worker_send "$2" "$_WORKER_MSG" "$3"' \
            _ "$SPAWN" "$NAME" "$PROJECT"
        ;;
    wait)
        OVERRIDE=""
        TIMEOUT=3300
        while [ $# -gt 0 ]; do
            case "$1" in
                --timeout) TIMEOUT="${2:?worker-cli wait: --timeout needs a value}"; shift 2 ;;
                --timeout=*) TIMEOUT="${1#--timeout=}"; shift ;;
                *) OVERRIDE="$1"; shift ;;
            esac
        done
        PROJECT=$(resolve_project_path "$OVERRIDE")
        START_TS=$(date +%s)
        STABLE_COUNT=0
        while true; do
            NOW=$(date +%s)
            if [ $((NOW - START_TS)) -ge "$TIMEOUT" ]; then
                echo "timeout"
                exit 0
            fi
            # Best-effort listing — any failure (tmux hiccup, etc.) yields empty NAMES,
            # which is handled identically to "no worker visible yet": keep waiting.
            NAMES=$(bash -c "source \"$SPAWN\" && worker_list \"\$1\"" _ "$PROJECT" 2>/dev/null \
                | awk '{print $1}' || true)
            if [ -z "$NAMES" ]; then
                STABLE_COUNT=0
                sleep "$_WAIT_POLL_INTERVAL"
                continue
            fi
            ALL_IDLE=1
            while IFS= read -r WNAME; do
                [ -z "$WNAME" ] && continue
                STATUS=$(bash -c "source \"$SPAWN\" && worker_status \"\$1\" \"\$2\"" \
                    _ "$WNAME" "$PROJECT" 2>/dev/null || echo "unknown")
                # Only a verbatim "idle" counts — working/limit reached/unknown/probe-error
                # all fall through to NOT idle, per the fail-toward-waiting contract.
                if [ "$STATUS" != "idle" ]; then
                    ALL_IDLE=0
                    break
                fi
                BG=$(_wait_has_live_bg_task "$WNAME" "$PROJECT")
                if [ "$BG" != "no" ]; then
                    ALL_IDLE=0
                    break
                fi
            done <<< "$NAMES"
            if [ "$ALL_IDLE" = "1" ]; then
                STABLE_COUNT=$((STABLE_COUNT + 1))
            else
                STABLE_COUNT=0
            fi
            if [ "$STABLE_COUNT" -ge "$_WAIT_STABLE_SAMPLES" ]; then
                echo "workers idle"
                exit 0
            fi
            sleep "$_WAIT_POLL_INTERVAL"
        done
        ;;
    spawn)
        [ $# -lt 3 ] && { echo "worker-cli spawn: need <name> <prompt_file> <project_path> [model] [--no-worktree]" >&2; exit 2; }
        NAME="$1"
        PROMPT_FILE="$2"; [[ "$PROMPT_FILE" != /* ]] && PROMPT_FILE="$(pwd)/$PROMPT_FILE"
        REQUESTED=$(resolve_project_path "$3")
        if [ -n "${PROXY_PROJECT_PATH:-}" ]; then
            PROJECT=$(resolve_project_path "$PROXY_PROJECT_PATH")
            if [ "$REQUESTED" != "$PROJECT" ]; then
                echo "worker-cli spawn: spawning into main session project $PROJECT (PROXY_PROJECT_PATH policy); project_path arg '$3' ignored — for cross-project work, create a worktree in the target project and have the worker cd there" >&2
            fi
        else
            PROJECT="$REQUESTED"
        fi
        MODEL="${4:-claude-sonnet-5}"
        WORKTREE_FLAG=""
        [ "${5:-}" = "--no-worktree" ] && WORKTREE_FLAG="--no-worktree"
        cd "$PLUGIN" && python3 -m src.spawn.spawn "$NAME" "$PROMPT_FILE" "$PROJECT" "$MODEL" $WORKTREE_FLAG
        registry_write "$NAME" "$PROJECT"
        _DEATH_LOG="$HOME/.claude/worker-deaths.log"
        _SPAWN_SESSION="worker-$(basename "$PROJECT")-$NAME"
        tmux set-hook -t "$_SPAWN_SESSION" pane-died \
            "run-shell 'echo \"\$(date -Iseconds) worker=$NAME session=#{session_name} status=#{pane_dead_status} signal=#{pane_dead_signal}\" >> $_DEATH_LOG'" 2>/dev/null || true
        ;;
    revive)
        [ $# -lt 1 ] && { echo "worker-cli revive: need <name> [project_path]" >&2; exit 2; }
        NAME="$1"
        OVERRIDE="${2:-}"
        PROJECT=$(resolve_worker_project "$NAME" "$OVERRIDE")
        # Delegate full revive flow (gates + proxy setup + session recreate) to worker_revive
        # in tmux_spawn.sh. CRITICAL: this now includes _worker_proxy_setup so the prompt-cache
        # prefix on the Anthropic side matches what the worker had before death — without that
        # the entire conversation context would be re-uploaded on resume (cache miss).
        bash -c "source \"$SPAWN\" && worker_revive \"\$1\" \"\$2\"" _ "$NAME" "$PROJECT"
        ;;
    worktree)
        [ $# -lt 2 ] && { echo "worker-cli worktree: need <name> <target-repo> [branch]" >&2; exit 2; }
        NAME="$1"
        TARGET=$(resolve_project_path "$2")
        BRANCH="${3:-$NAME}"
        # Validate target is a git repo
        if ! git -C "$TARGET" rev-parse --git-dir >/dev/null 2>&1; then
            echo "worker-cli worktree: '$TARGET' is not a git repo" >&2
            exit 1
        fi
        # Fail cleanly if worktree already exists
        WT_PATH="$TARGET/.claude/worktrees/$NAME"
        if [ -d "$WT_PATH" ]; then
            echo "worker-cli worktree: worktree already exists at $WT_PATH" >&2
            exit 1
        fi
        # Create worktree — git's own error message surfaces on failure
        if ! git -C "$TARGET" worktree add ".claude/worktrees/$NAME" -b "$BRANCH"; then
            echo "worker-cli worktree: failed to create worktree in $TARGET" >&2
            exit 1
        fi
        sidecar_append "$NAME" "$TARGET" "$BRANCH"
        echo "$WT_PATH"
        ;;
    worktree-rm)
        [ $# -lt 2 ] && { echo "worker-cli worktree-rm: need <target-repo> <name> [branch]" >&2; exit 2; }
        TARGET=$(resolve_project_path "$1")
        NAME="$2"
        BRANCH="${3:-$NAME}"
        git -C "$TARGET" worktree remove --force ".claude/worktrees/$NAME" 2>/dev/null \
            && echo "  worktree removed" || echo "  worktree not found"
        git -C "$TARGET" branch -D "$BRANCH" 2>/dev/null \
            && echo "  branch '$BRANCH' deleted" || echo "  branch '$BRANCH' not found"
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        echo "worker-cli: unknown subcommand '$CMD'" >&2
        usage >&2
        exit 2
        ;;
esac
